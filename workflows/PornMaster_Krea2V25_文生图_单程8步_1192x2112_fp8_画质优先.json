,"link":469},{"localized_name":"正面条件","name":"positive","type":"CONDITIONING","link":470},{"localized_name":"负面条件","name":"negative","type":"CONDITIONING","link":471},{"localized_name":"Latent图像","name":"latent_image","type":"LATENT","link":468},{"localized_name":"种子","name":"seed","type":"INT","widget":{"name":"seed"},"link":null},{"localized_name":"步数","name":"steps","type":"INT","widget":{"name":"steps"},"link":null},{"localized_name":"cfg","name":"cfg","type":"FLOAT","widget":{"name":"cfg"},"link":null},{"localized_name":"采样器名称","name":"sampler_name","type":"COMBO","widget":{"name":"sampler_name"},"link":null},{"localized_name":"调度器","name":"scheduler","type":"COMBO","widget":{"name":"scheduler"},"link":null},{"localized_name":"降噪","name":"denoise","type":"FLOAT","widget":{"name":"denoise"},"link":null},{"localized_name":"control_after_generate","name":"control_after_generate","type":"STRING","widget":{"name":"control_after_generate"},"link":null}],"outputs":[{"localized_name":"Latent","name":"LATENT","type":"LATENT","links":[197]}],"title":"⑪ 第二程 4 步 / denoise 0.39（新增）","properties":{"cnr_id":"comfy-core","ver":"0.38.2","Node name for S&R":"KSampler"},"widgets_values":[1040511035514967,"randomize",4,1,"euler_ancestral","beta",0.39],"widgets_values_named":{"seed":1040511035514967,"control_after_generate":"randomize","steps":4,"cfg":1,"sampler_name":"euler_ancestral","scheduler":"beta","denoise":0.39},"color":"#322","bgcolor":"#533"},{"id":180,"type":"MarkdownNote","pos":[100,1000],"size":[580,700],"flags":{},"order":0,"mode":0,"inputs":[],"outputs":[],"properties":{"text":""},"widgets_values":["## 质量优先版 · fp8 + 单程 8 步直出 1192x2112（9:16 / 2.52MP）\n\n实测（同提示词同 seed / 热缓存）：\n\n| 方案 | 输出 | 耗时 |\n|---|---|---|\n| 原版 fp8 双程 8+4 步 | 1176x2088 | 34.1 s |\n| **本版 fp8 单程 8 步** | **1192x2112** | **36.2 s** |\n| int4 单程 2.4MP | 1192x2112 | 20.3 s |\n\n单程比双程慢约 2 秒，换来更干净的高频细节（发丝、布料、裙摆边缘），\n原因同 V8SE：第二程会插值 + 再加一次噪。\n\nfp8 权重 12.5 GB 超过本机 11.9 GB 显存，每步都要搬权重，所以它天生慢。\n\n### int4 备选（想快 46%）\n`krea2\\pornmasterKrea2_v25Turbo_int4.safetensors` 是**同一个模型的 4bit 量化**，\n不是小模型（参数量不变，12.5GB → 7.7GB）。\n同 seed 逐像素：PSNR 17.62 dB / SSIM 0.61（脸部 0.54），\n1:1 下雪晶形态、发丝锐度**有可见差异**（int4 更碎更硬），构图/五官/光影一致。\n是否接受取决于用途，建议自己抽 10 张同 seed 比后再决定。\n\n### 尺寸说明\n长边 2112，接近 2K（2048）但严格说是 2.52MP。\nSeedVR2 2K 档对这张图只有 0.97 倍（会略微缩），想要更大用 4K 档。\n\n- ① `UNETLoader` 当前 fp8；换 int4 直接改下拉\n- 175 / 176 第二程已 bypass\n- ④ `megapixels` 2.4；想快回到 1.08 得 784x1392（约 16 s）"],"color":"#432","bgcolor":"#653"}],"links":[[184,29,0,63,3,"LATENT"],[197,176,0,30,0,"LATENT"],[313,100,0,30,1,"VAE"],[441,90,0,63,1,"CONDITIONING"],[453,99,0,90,0,"CLIP"],[459,30,0,106,0,"IMAGE"],[461,106,0,152,0,"IMAGE"],[462,90,0,173,0,"CONDITIONING"],[463,173,0,63,2,"CONDITIONING"],[464,98,0,63,0,"MODEL"],[465,174,0,29,0,"INT"],[466,174,1,29,1,"INT"],[467,63,0,175,0,"LATENT"],[468,175,0,176,3,"LATENT"],[469,98,0,176,0,"MODEL"],[470,90,0,176,1,"CONDITIONING"],[471,173,0,176,2,"CONDITIONING"]],"groups":[],"config":{},"extra":{"ds":{"scale":0.6745548641717839,"offset":[377.8804021615765,191.786832942523]},"frontendVersion":"1.53.10","workflowRendererVersion":"LG","groupNodes":{},"controller_panel":{"controllers":{},"hidden":true,"highlight":true,"version":2,"default_order":[]},"node_versions":{"comfy-core":"0.3.14","comfyui-impact-subpack":"74db20c95eca152a6d686c914edc0ef4e4762cb8","comfyui-impact-pack":"1ae7cae2df8cca06027edfa3a24512671239d6c4"},"ue_links":[],"VHS_latentpreview":false,"VHS_latentpreviewrate":0,"VHS_MetadataImage":true,"VHS_KeepIntermediate":true},"extensions":{"widget_idx_map":{"63":{"noise_seed":1,"sampler_name":5,"scheduler":6}},"seed_widgets":{"63":1}},"version":0.4}