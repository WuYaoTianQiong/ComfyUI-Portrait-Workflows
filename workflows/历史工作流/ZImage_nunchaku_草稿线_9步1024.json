层细微的水雾。背景是便利店明亮温暖的灯光，脚下的白色瓷砖地面光滑如镜，反射着斑驳的霓虹光影。\n\n街拍人像，超写实画质。"}, "color": "#223", "bgcolor": "#335"}, {"id": 7, "type": "ConditioningZeroOut", "pos": [1359.0908536044033, 130], "size": [300, 60], "flags": {}, "order": 7, "mode": 0, "inputs": [{"localized_name": "条件", "name": "conditioning", "type": "CONDITIONING", "link": 13}], "outputs": [{"localized_name": "条件", "name": "CONDITIONING", "type": "CONDITIONING", "links": [3]}], "title": "负向清零（CFG=1，负面不生效）", "properties": {"cnr_id": "comfy-core", "ver": "0.38.2", "Node name for S&R": "ConditioningZeroOut"}, "color": "#223", "bgcolor": "#335"}, {"id": 8, "type": "KSampler", "pos": [1759.0908536044033, 130], "size": [330, 300], "flags": {}, "order": 8, "mode": 0, "inputs": [{"localized_name": "模型", "name": "model", "type": "MODEL", "link": 1}, {"localized_name": "正面条件", "name": "positive", "type": "CONDITIONING", "link": 2}, {"localized_name": "负面条件", "name": "negative", "type": "CONDITIONING", "link": 3}, {"localized_name": "Latent图像", "name": "latent_image", "type": "LATENT", "link": 4}, {"localized_name": "种子", "name": "seed", "type": "INT", "widget": {"name": "seed"}, "link": null}, {"localized_name": "步数", "name": "steps", "type": "INT", "widget": {"name": "steps"}, "link": null}, {"localized_name": "cfg", "name": "cfg", "type": "FLOAT", "widget": {"name": "cfg"}, "link": null}, {"localized_name": "采样器名称", "name": "sampler_name", "type": "COMBO", "widget": {"name": "sampler_name"}, "link": null}, {"localized_name": "调度器", "name": "scheduler", "type": "COMBO", "widget": {"name": "scheduler"}, "link": null}, {"localized_name": "降噪", "name": "denoise", "type": "FLOAT", "widget": {"name": "denoise"}, "link": null}, {"localized_name": "control_after_generate", "name": "control_after_generate", "type": "STRING", "widget": {"name": "control_after_generate"}, "link": null}], "outputs": [{"localized_name": "Latent", "name": "LATENT", "type": "LATENT", "links": [5]}], "title": "⑧ 官方 9 步 / cfg 1 / res_multistep", "properties"