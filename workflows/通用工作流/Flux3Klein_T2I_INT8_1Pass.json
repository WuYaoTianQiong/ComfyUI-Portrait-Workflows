zed_name":"denoised_output","name":"denoised_output","type":"LATENT","links":null}],"properties":{"Node name for S&R":"SamplerCustomAdvanced","cnr_id":"comfy-core","ver":"0.41.3"},"widgets_values":[]},{"id":12,"type":"VAEDecode","pos":[1620,80],"size":[200,46],"flags":{},"order":12,"mode":0,"inputs":[{"localized_name":"samples","name":"samples","type":"LATENT","link":12},{"localized_name":"vae","name":"vae","type":"VAE","link":3}],"outputs":[{"localized_name":"IMAGE","name":"IMAGE","type":"IMAGE","links":[13]}],"properties":{"Node name for S&R":"VAEDecode","cnr_id":"comfy-core","ver":"0.41.3"},"widgets_values":[]},{"id":13,"type":"SaveImage","pos":[1620,180],"size":[520,620],"flags":{},"order":13,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":13},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","link":null,"widget":{"name":"filename_prefix"}}],"outputs":[],"properties":{"Node name for S&R":"SaveImage","cnr_id":"comfy-core","ver":"0.41.3"},"widgets_values":["Flux3Klein_T2I_INT8_1Pass-%width%x%height%-%hour%%minute%%second%"]},{"id":20,"type":"MarkdownNote","pos":[40,620],"size":[800,620],"flags":{},"order":14,"mode":0,"inputs":[],"outputs":[],"properties":{"Node name for S&R":"MarkdownNote","cnr_id":"comfy-core","ver":"0.41.3"},"widgets_values":["## FLUX 3 Image Klein · 文生图（12G 实测可用）\n\n**底模** `flux3-image-klein-int8-convrot`（蒸馏版 5.43 GiB）· **文本编码器** `qwen3vl_4b_int8_convrot`（`CLIPLoader type=flux3`）· **VAE** `flux2-vae`\n\n| 项 | 值 | 说明 |\n|---|---|---|\n| 采样 | **16 步** / euler / `Flux2Scheduler` | 蒸馏版固定 16 步 |\n| CFG | **1.0** | 负数走 `ConditioningZeroOut`，cfg 必须 1 |\n| 分辨率 | 1024×1536（2:3） | 改 `EmptyLatentImage` 与 `Flux2Scheduler` 的 width/height **两处** |\n| 实测 | 1024×1536 **15.2 s** / 张（RTX 5070 12G，热缓存） | 与 Krea2 单程 8 步（17~18 s）同量级 |\n\n**提示词**：FLUX 系建议英文长句；中文长提示词未测。\n**prompt upsampler 未装**（官方 `qwen3.5_9b_flux3_prompt_upsampler_int8` 9.75 GB），短提示词可能偏平庸。\n**内核**：ComfyUI ≥ 0.41.2（本机 0.41.3 已验证，无需额外插件）。\n\n---\n\n## 改出图尺寸：两个下拉，选完就完\n\n画幅节点（`ResolutionSizer`，本机自定义节点）有**两个下拉**，不用手填数字：\n\n- **aspect_ratio**：比例（1:1 / 2:3 / 3:4 / 9:16 / 3:2 / 4:3 / 16:9 / 21:9）\n- **megapixels**：像素量档位（0.4 / 0.55 / 0.75 / 1.0 / 1.25 / 1.5 / 1.8 / 2.16 / 2.34 / 2.4 / 3.0 / 4.0）\n  单位是 MiP＝1024×1024，不是 100 万像素——所以 2.4 实际约 2.52 MP。\n\n| 像素量 | 2:3 竖 | 3:4 竖 | 9:16 竖 | 1:1 | 16:9 |\n|---|---|---|---|---|---|\n| 0.55 | 624×928 | 656×880 | 568×1016 | 760×760 | 1016×568 |\n| 1.0 | 840×1256 | 888×1184 | 768×1368 | 1024×1024 | 1368×768 |\n| 1.5 | 1024×1536 **← 当前** | 1088×1448 | 944×1672 | 1256×1256 | 1672×944 |\n| 2.16 | 1232×1840 | 1304×1736 | 1128×2008 | 1504×1504 | 2008×1128 |\n| 2.4 | 1296×1944 | 1376×1832 | 1192×2112 | 1584×1584 | 2112×1192 |\n\n**当前：2:3 · 1.5 → 1024×1536**\n\n### 三个常改方向\n\n- 想快（草稿/试构图）：选 **0.55**，约 7~8 s/张\n- 想稳出大图：**2.16 ~ 2.4**（本机 12G 下 2.4 峰值约 11 GB）\n- 只换比例（像素量不变）：只动第一个下拉\n\n### 两个坑\n\n1. **别去改下面的「空 latent」宽高** —— 它的 width/height 被连线锁住（灰色），\n   改了不生效，实际尺寸永远由画幅节点决定。\n2. **本工作流没有 9:21（竖长图）**：`21:9` 出的是横图。真要 9:21，只能把空 latent 的\n   width/height 右键 **「转换为输入」** 断开设画幅的连线，再手填 1024×2400 之类；\n   或直接在 Atelier 里选 9:21（那边会用字面量下发）。\n"],"title":"使用说明 / 实测参数"},{"id":21,"type":"ResolutionSizer","pos":[40,520],"size":[270,130],"flags":{},"order":5,"mode":0,"inputs":[{"localized_name":"宽高比","name":"aspect_ratio","type":"COMBO","widget":{"name":"aspect_ratio"},"link":null},{"localized_name":"百万像素","name":"megapixels","type":"FLOAT","widget":{"name":"megapixels"},"link":null},{"localized_name":"倍数","name":"multiple","type":"INT","widget":{"name":"multiple"},"link":null}],"outputs":[{"localized_name":"width","name":"width","type":"INT","links":[14]},{"localized_name":"height","name":"height","type":"INT","links":[15]}],"title":"画幅｜2:3 · 1.5 → 1024×1536","properties":{"Node name for S&R":"ResolutionSizer"},"widgets_values":["2:3 (Portrait Photo)",1.5,8],"widgets_values_named":{"aspect_ratio":"2:3 (Portrait Photo)","megapixels":1.5,"multiple":8}}],"links":[[1,1,0,7,0,"MODEL"],[2,2,0,4,1,"CLIP"],[3,3,0,12,1,"VAE"],[4,4,0,5,0,"CONDITIONING"],[5,4,0,7,1,"CONDITIONING"],[6,5,0,7,2,"CONDITIONING"],[7,6,0,11,4,"LATENT"],[8,7,0,11,1,"GUIDER"],[9,8,0,11,2,"SAMPLER"],[10,9,0,11,3,"SIGMAS"],[11,10,0,11,0,"NOISE"],[12,11,0,12,0,"LATENT"],[13,12,0,13,0,"IMAGE"],[14,21,0,6,0,"INT"],[15,21,1,6,1,"INT"]],"groups":[],"config":{},"extra":{"ds":{"scale":0.75,"offset":[0,0]}},"version":0.4}