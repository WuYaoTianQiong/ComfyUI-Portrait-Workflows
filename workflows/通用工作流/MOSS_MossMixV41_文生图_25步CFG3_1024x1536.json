me":"sampler_name","name":"sampler_name","type":"COMBO","link":null,"widget":{"name":"sampler_name"}},{"localized_name":"scheduler","name":"scheduler","type":"COMBO","link":null,"widget":{"name":"scheduler"}},{"localized_name":"denoise","name":"denoise","type":"FLOAT","link":null,"widget":{"name":"denoise"}}],"outputs":[{"localized_name":"LATENT","name":"LATENT","type":"LATENT","links":[8]}],"properties":{"Node name for S&R":"KSampler","cnr_id":"comfy-core","ver":"0.45.2"},"widgets_values":[20261112,"randomize",25,3.0,"euler","simple",1.0]},{"id":8,"type":"VAEDecode","pos":[1300,80],"size":[220,46],"flags":{},"order":7,"mode":0,"inputs":[{"localized_name":"samples","name":"samples","type":"LATENT","link":8},{"localized_name":"vae","name":"vae","type":"VAE","link":3}],"outputs":[{"localized_name":"IMAGE","name":"IMAGE","type":"IMAGE","links":[9]}],"properties":{"Node name for S&R":"VAEDecode","cnr_id":"comfy-core","ver":"0.45.2"},"widgets_values":[]},{"id":9,"type":"SaveImage","pos":[1300,180],"size":[520,620],"flags":{},"order":8,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":9},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","link":null,"widget":{"name":"filename_prefix"}}],"outputs":[],"properties":{"Node name for S&R":"SaveImage","cnr_id":"comfy-core","ver":"0.45.2"},"widgets_values":["moss-%width%x%height%-%hour%%minute%%second%"]},{"id":20,"type":"MarkdownNote","pos":[40,480],"size":[860,560],"flags":{},"order":9,"mode":0,"inputs":[],"outputs":[],"properties":{"Node name for S&R":"MarkdownNote","cnr_id":"comfy-core","ver":"0.45.2"},"widgets_values":["## MOSS-Image · Moody Moss Mix V4.1（12G 实测可用）\n\n**底模** `Moody-Moss-Mix-V4.1_int8`（5.09 GB，MOSS-Image 5B + catlover1937 全量微调） · **文本编码器** `qwen3.5_9b_w4a8_gptq`（`CLIPLoader type=moss_image`） · **VAE** `flux2-vae_small`\n\n| 项 | 值 | 说明 |\n|---|---|---|\n| 采样 | **25 步** / **CFG 3.0** / euler / simple | 作者标注的参数，别按 FLUX 那套 16 步 CFG1 |\n| 分辨率 | 1024×1536（1.5 MP） | 改 `EmptyLatentImage` 两处即可；1 MP 更省显存 |\n| 显存 | 12G 无 OOM（峰值约 9~10 GB） | TE 7.34 GB **靠 ComfyUI 自动 offload** |\n| **TE offload** | `CLIPLoader.device = default`（自动） | 显存实在不够时改成 **`cpu`**：能跑但每张明显变慢（TE 全在内存算） |\n| 实测（RTX 5070 12G） | 人像 **51.8 s** · 图内多字 **28.2 s** · 中文长提示词 34.5 s | ComfyUI 0.45.2 |\n\n**版本要求**：ComfyUI **≥ 0.42.2**（`moss_image` 于 v0.42.2 首次支持、v0.43.0 进核心）；本机已升到 0.45.2。\n\n**优势（实测）**\n- **图内中文最强**：便利店价签「冰镇乌龙茶 / 500毫升 / 特价6元」三行**零错字**、黑体排版整齐（FLUX3 仅 1/3、Qwen21 3/3 但排版不如它）\n- **亚洲人像好**：韩系精致脸，与 Moody Krea2 V8 同级，明显优于 FLUX3 裸版\n- 中文长提示词（1941 字）构图要素能落全；⚠️ 但对「服装尺度」理解偏松，写\"薄纱/缠绕\"容易出暴露效果，需在提示词里明确写\"保守、日常着装\"\n\n**提示词建议**：MOSS 支持最长 4096 token，**写长句描述**（谁/穿什么/在哪/什么光/什么镜头），比标签串好。\n\n**模型文件**\n- `models/diffusion_models/Moody-Moss-Mix-V4.1_int8.safetensors`（SHA256 `FA307E27…`）\n- `models/text_encoders/qwen3.5_9b_w4a8_gptq.safetensors`\n- `models/vae/flux2-vae_small.safetensors`（**不是** flux2-vae，别用错）\n"],"title":"使用说明 / 实测参数"}],"links":[[1,1,0,7,0,"MODEL"],[2,2,0,4,1,"CLIP"],[3,3,0,8,1,"VAE"],[4,4,0,5,0,"CONDITIONING"],[5,4,0,7,1,"CONDITIONING"],[6,5,0,7,2,"CONDITIONING"],[7,6,0,7,3,"LATENT"],[8,7,0,8,0,"LATENT"],[9,8,0,9,0,"IMAGE"]],"groups":[],"config":{},"extra":{"ds":{"scale":0.75,"offset":[0,0]}},"version":0.4}