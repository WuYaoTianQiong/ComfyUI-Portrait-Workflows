for S&R":"KSampler","cnr_id":"comfy-core","ver":"0.45.2"},"widgets_values":[20261112,"randomize",25,3.0,"euler","simple",1.0]},{"id":10,"type":"VAEDecode","pos":[1360,80],"size":[220,46],"flags":{},"order":9,"mode":0,"inputs":[{"localized_name":"samples","name":"samples","type":"LATENT","link":9},{"localized_name":"vae","name":"vae","type":"VAE","link":3}],"outputs":[{"localized_name":"IMAGE","name":"IMAGE","type":"IMAGE","links":[10]}],"properties":{"Node name for S&R":"VAEDecode","cnr_id":"comfy-core","ver":"0.45.2"},"widgets_values":[]},{"id":11,"type":"SaveImage","pos":[1360,180],"size":[520,620],"flags":{},"order":10,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":10},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","link":null,"widget":{"name":"filename_prefix"}}],"outputs":[],"properties":{"Node name for S&R":"SaveImage","cnr_id":"comfy-core","ver":"0.45.2"},"widgets_values":["MossMixEdit-%width%x%height%-%hour%%minute%%second%"]},{"id":20,"type":"MarkdownNote","pos":[980,400],"size":[900,620],"flags":{},"order":11,"mode":0,"inputs":[],"outputs":[],"properties":{"Node name for S&R":"MarkdownNote","cnr_id":"comfy-core","ver":"0.45.2"},"widgets_values":["## MOSS-Image · 图生图 / 指令编辑（Moody Moss Mix V4.1）\n\n**链路**：`UNETLoader` → `LoraLoaderModelOnly(moss_image_edit_lora_rank_64_bf16, 1.0)` → `KSampler`；\n条件走 `TextEncodeMOSSImageEdit`（把源图编成参考，连同指令一起喂给 Qwen3.5-9B 文本编码器）。\n\n| 项 | 值 | 说明 |\n|---|---|---|\n| 步数 / CFG | **25 步** / **3.0** / euler / simple | 与文生图一致 |\n| `edit_format` | **`Moss-Image-Edit`** | 官方 Comfy-Org 这份 LoRA 对应档；另两档 `ai-toolkit` / `ai-toolkit (kv_cache off)` 是给自训 LoRA 用的，**选错会出图但身份漂移** |\n| `image_strength` | 1.0 | >1 更强调参考图 |\n| 参考图 | `LoadImage` → `images.image_0`（最多 10 张） | 配 `vae` 时编成 reference latents |\n| 尺寸 | `EmptyLatentImage` 1024×1536 | **建议与源图一致**，否则会变形 |\n| 实测 | **58.3 s**（1024×1536，RTX 5070 12G） | 换装：脸/姿势/机位/背景全保留，皮革拉链铆钉细节完整；裤子颜色轻微漂移 |\n\n**指令写法**：先写\"要改什么\"，再补\"要保留什么\"，例如\n`把她的白色棉质衬衫换成黑色皮夹克，内搭白色T恤；保持同一个人的脸、同样的姿势、同样的机位和同样的雨后街道背景，只改衣服`\n\n**与其它编辑线的差别（实测）**\n- 比 `FLUX3Klein_单图指令编辑` 慢 2.4 倍，但**材质细节更足、脸一致性更好**；\n- 比 `PornMaster_Flux2Klein9B_单图编辑_可选遮罩` 慢 3 倍以上，且**没有遮罩 + 保留区像素级贴回**；只改一处、其余必须像素不动时仍用 F2K。\n\n**必备文件**\n- `models/loras/moss_image_edit_lora_rank_64_bf16.safetensors`（0.30 GB）\n- `models/diffusion_models/Moody-Moss-Mix-V4.1_int8.safetensors`\n- `models/text_encoders/qwen3.5_9b_w4a8_gptq.safetensors` + `models/vae/flux2-vae_small.safetensors`\n"],"title":"使用说明 / 实测参数"}],"links":[[1,1,0,4,0,"MODEL"],[2,2,0,6,0,"CLIP"],[3,3,0,10,1,"VAE"],[4,4,0,9,0,"MODEL"],[5,6,0,7,0,"CONDITIONING"],[6,6,0,9,1,"CONDITIONING"],[7,7,0,9,2,"CONDITIONING"],[8,8,0,9,3,"LATENT"],[9,9,0,10,0,"LATENT"],[10,10,0,11,0,"IMAGE"],[11,3,0,6,5,"VAE"],[12,5,0,6,3,"IMAGE"]],"groups":[],"config":{},"extra":{"ds":{"scale":0.72,"offset":[0,0]}},"version":0.4}