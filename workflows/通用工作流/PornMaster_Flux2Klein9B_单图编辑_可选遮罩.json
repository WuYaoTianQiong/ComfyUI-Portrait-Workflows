x_id":"yolain/ComfyUI-Easy-Use","ver":"1.3.3","Node name for S&R":"easy cleanGpuUsed","cnr_id":"comfyui-easy-use"}},{"id":21,"type":"SaveImage","pos":[3870,130],"size":[320,280],"flags":{},"order":23,"mode":0,"inputs":[{"label":"images","localized_name":"图片","name":"images","type":"IMAGE","link":30},{"label":"filename_prefix","localized_name":"文件名前缀","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null}],"outputs":[{"label":"image_urls","localized_name":"images","name":"images","type":"IMAGE","links":[]}],"properties":{"cnr_id":"comfy-core","ver":"0.3.49","Node name for S&R":"SaveImage","widget_ue_connectable":{},"ttNbgOverride":{"bgcolor":"#335","groupcolor":"#88A","color":"#223"}},"widgets_values":["f2k-edit-%width%x%height%-%hour%%minute%%second%"],"widgets_values_named":{"filename_prefix":"f2k-edit-%width%x%height%-%hour%%minute%%second%"},"color":"#223","bgcolor":"#335"},{"id":22,"type":"Image Comparer (rgthree)","pos":[3450,366],"size":[320,260],"flags":{},"order":21,"mode":0,"inputs":[{"dir":3,"label":"image_a","name":"image_a","type":"IMAGE","link":31},{"dir":3,"label":"image_b","name":"image_b","type":"IMAGE","link":32}],"outputs":[{"dir":4,"name":"images","shape":3,"type":"IMAGE","links":[]}],"properties":{"cnr_id":"rgthree-comfy","ver":"1.0.2512112053","comparer_mode":"Slide","ue_properties":{"version":"7.5.2","widget_ue_connectable":{},"input_ue_unconnectable":{}}},"widgets_values":[[]],"widgets_values_named":{"rgthree_comparer":{"images":[]}}},{"id":23,"type":"PlaySound|pysssss","pos":[3450,756],"size":[270,106],"flags":{},"order":22,"mode":0,"inputs":[{"localized_name":"any","name":"any","type":"*","link":33},{"localized_name":"mode","name":"mode","type":"COMBO","widget":{"name":"mode"},"link":null},{"localized_name":"volume","name":"volume","type":"FLOAT","widget":{"name":"volume"},"link":null},{"localized_name":"file","name":"file","type":"STRING","widget":{"name":"file"},"link":null}],"outputs":[{"localized_name":"*","name":"*","shape":6,"type":"*","links":[]}],"properties":{"cnr_id":"comfyui-custom-scripts","ver":"609f3afaa74b2f88ef9ce8d939626065e3247469","Node name for S&R":"PlaySound|pysssss"},"widgets_values":["always",0.5,"notify.mp3"],"widgets_values_named":{"mode":"always","volume":0.5,"file":"notify.mp3"}},{"id":24,"type":"MarkdownNote","pos":[100,1606],"size":[660,820],"flags":{},"order":6,"mode":0,"inputs":[],"outputs":[],"properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.7","input_ue_unconnectable":{}}},"widgets_values":["【单图指令编辑 · 可选遮罩 · 双模式】Flux2 Klein 9B Turbo fp8 / CFG 1 / euler / 4 步\n\n■ 两种模式自动切换（无需任何手动设置）\n  · 完全不涂遮罩 → 自动全图指令编辑（整张图按提示词重绘）\n  · 涂了遮罩     → 局部重绘，只改涂过的地方，其余像素级保留\n  原理：入口 LoadImage 的 MASK 全 0 时，归约链把它变成全 1，\n  于是 VAEEncodeForInpaint 的 noise_mask 全 1 → 采样时不锁原图 → 全图重绘；\n  同理出口 ImageCompositeMasked 的 mask 全 1 → 直接采用生成图。\n  只要涂了任何一个像素，两条链都恢复成\"用户遮罩\"，行为与旧版完全一致。\n\n■ 遮罩用法：右键「主图」→ Open in MaskEditor，画笔【涂哪里 = 改哪里】。\n  原理：LoadImage 的 MASK = 1 - alpha（nodes.py:1771）；MaskEditor 里\n  涂过的地方存为透明(alpha=0) → mask=1 → 重绘。\n\n■ 双重锁定（涂遮罩时的核心机制）\n  ① latent 域硬锁：comfy/samplers.py:638-642\n     out = out*denoise_mask + 原图latent*latent_mask（每步强制还原）\n  ② 图像域合成：ImageCompositeMasked 用原图 mask 把保留区贴回原图。\n  为什么需要②：VAEDecode 是全局的，大幅重绘会渗漏到保留区。\n\n■ 尺寸：ImageResizeKJ(width=0,height=0,divisible_by=16)\n  = 保持输入原始尺寸，仅向下对齐到 16 的倍数（1152x2048 原样进原样出）。\n  VAE latent 网格对齐，VAEEncodeForInpaint 不做居中裁剪，\n  ImageCompositeMasked 才能零偏移对齐。\n  若显存吃紧，可把它换成 ImageScaleToTotalPixels(1.5MP) 换回缩图模式。\n\n■ grow_mask_by=8：遮罩边缘膨胀 8px，规避 latent 16 像素网格接缝（0~64）。\n\n■ 这不是 img2img：原图同时充当遮罩基准、ReferenceLatent 参考条件、合成底图。\n\n■ 显存：Flux2 Klein 9B turbo fp8 = 8.79 GiB。原尺寸 1152x2048(2.25MP) 比\n  1.5MP 多约 50% latent 序列长度，RTX 5070 12G 通常仍可跑。\n\n■ 用法：提示词写「Referring to image 1, ...」形式的自然语言指令。\n  不涂遮罩时提示词必须写清楚要改成什么，模型没有任何\"保留原图\"的约束。\n"],"widgets_values_named":{"text":"【单图指令编辑 · 可选遮罩 · 双模式】Flux2 Klein 9B Turbo fp8 / CFG 1 / euler / 4 步\n\n■ 两种模式自动切换（无需任何手动设置）\n  · 完全不涂遮罩 → 自动全图指令编辑（整张图按提示词重绘）\n  · 涂了遮罩     → 局部重绘，只改涂过的地方，其余像素级保留\n  原理：入口 LoadImage 的 MASK 全 0 时，归约链把它变成全 1，\n  于是 VAEEncodeForInpaint 的 noise_mask 全 1 → 采样时不锁原图 → 全图重绘；\n  同理出口 ImageCompositeMasked 的 mask 全 1 → 直接采用生成图。\n  只要涂了任何一个像素，两条链都恢复成\"用户遮罩\"，行为与旧版完全一致。\n\n■ 遮罩用法：右键「主图」→ Open in MaskEditor，画笔【涂哪里 = 改哪里】。\n  原理：LoadImage 的 MASK = 1 - alpha（nodes.py:1771）；MaskEditor 里\n  涂过的地方存为透明(alpha=0) → mask=1 → 重绘。\n\n■ 双重锁定（涂遮罩时的核心机制）\n  ① latent 域硬锁：comfy/samplers.py:638-642\n     out = out*denoise_mask + 原图latent*latent_mask（每步强制还原）\n  ② 图像域合成：ImageCompositeMasked 用原图 mask 把保留区贴回原图。\n  为什么需要②：VAEDecode 是全局的，大幅重绘会渗漏到保留区。\n\n■ 尺寸：ImageResizeKJ(width=0,height=0,divisible_by=16)\n  = 保持输入原始尺寸，仅向下对齐到 16 的倍数（1152x2048 原样进原样出）。\n  VAE latent 网格对齐，VAEEncodeForInpaint 不做居中裁剪，\n  ImageCompositeMasked 才能零偏移对齐。\n  若显存吃紧，可把它换成 ImageScaleToTotalPixels(1.5MP) 换回缩图模式。\n\n■ grow_mask_by=8：遮罩边缘膨胀 8px，规避 latent 16 像素网格接缝（0~64）。\n\n■ 这不是 img2img：原图同时充当遮罩基准、ReferenceLatent 参考条件、合成底图。\n\n■ 显存：Flux2 Klein 9B turbo fp8 = 8.79 GiB。原尺寸 1152x2048(2.25MP) 比\n  1.5MP 多约 50% latent 序列长度，RTX 5070 12G 通常仍可跑。\n\n■ 用法：提示词写「Referring to image 1, ...」形式的自然语言指令。\n  不涂遮罩时提示词必须写清楚要改成什么，模型没有任何\"保留原图\"的约束。\n"},"color":"#222","bgcolor":"#000"},{"id":30,"type":"MaskToImage","pos":[900,2560],"size":[220,26],"flags":{},"order":130,"mode":0,"inputs":[{"localized_name":"遮罩","name":"mask","type":"MASK","link":40}],"outputs":[{"localized_name":"图像","name":"IMAGE","type":"IMAGE","links":[41,42]}],"properties":{"cnr_id":"comfy-core","ver":"0.8.2","Node name for S&R":"MaskToImage","ue_properties":{"widget_ue_connectable":{},"version":"7.7","input_ue_unconnectable":{}}},"widgets_values":[],"title":"遮罩→图像"},{"id":31,"type":"ImageScale","pos":[1200,2560],"size":[270,130],"flags":{},"order":131,"mode":0,"inputs":[{"localized_name":"图像","name":"image","type":"IMAGE","link":41},{"localized_name":"缩放算法","name":"upscale_method","type":"COMBO","widget":{"name":"upscale_method"},"link":null},{"localized_name":"宽度","name":"width","type":"INT","widget":{"name":"wid