{
  "ResolutionSizer": {
    "display_name": "画幅与倍率（下拉）",
    "inputs": {
      "aspect_ratio": { "name": "宽高比" },
      "base_megapixels": { "name": "原生像素量(MiP)" },
      "quality": { "name": "画质倍率" },
      "multiple": { "name": "取整倍数" }
    },
    "outputs": {
      "0": { "name": "宽度" },
      "1": { "name": "高度" }
    }
  },
  "ResolutionPresetPicker": {
    "display_name": "分辨率预设选择器",
    "inputs": {
      "preset": { "name": "画面尺寸" },
