<div id="promptListContainer">
  <div class="prompt-list" id="promptList">
    {% if prompts %}
    {% for p in prompts %}
    {% if p._is_template %}
    <div class="prompt-item template-item" data-id="{{ p.id }}">
      <div class="item-row">
        <div class="item-body" onclick="window.selectTemplateItem({{ p.id }}, '{{ p.name|e }}')">
          <div class="prompt-name">📦
            <span class="template-sync-{{ 'warn' if p._has_missing else 'ok' }}"
                  title="{{ '部分来源已删除' if p._has_missing else '来源正常' }}">{{ '○' if p._has_missing else '●' }}</span>
            {{ p.name|e }}
          </div>
          <div class="prompt-preview" style="color:var(--muted);font-size:11px">
            {{ (p.prompt_preview[:80] + '...') if p.prompt_preview and p.prompt_preview|length > 80 else (p.prompt_preview or '') }}
          </div>
          <div class="prompt-meta">
            <span class="tag">📦 组合模板</span>
            <span style="color:var(--muted);font-size:10px">{{ p.fragment_count or 0 }} 个碎片</span>
          </div>
        </div>
      </div>
    </div>
    {% else %}
    {% set tags_list = p.tags.split(',') if p.tags else [] %}
    <div class="prompt-item{% if p.id == selected_id %} active{% endif %}" data-id="{{ p.id }}">
      <div class="item-row">
        <label class="check-wrap" onclick="event.stopPropagation()">
          <input type="checkbox" class="item-check" data-id="{{ p.id }}"
                 onchange="window.toggleItemSelect({{ p.id }}, this.checked)"
                 {% if p.id in selected_ids %}checked{% endif %}>
        </label>
        <div class="item-body" onclick="window.selectPrompt({{ p.id }}, true, event.shiftKey, event.ctrlKey || event.metaKey)">
          {% if p.name %}<div class="prompt-name">{{ p.name|e }}</div>{% endif %}
          <div class="prompt-preview">{{ (p.prompt_preview[:60] + '...') if p.prompt_preview|length >= 60 else (p.prompt_preview or '') }}</div>
          <div class="prompt-meta">
            {% if p.steps %}<span class="badge">{{ p.steps }}步</span>{% endif %}
            {% if p.sampler %}<span style="color:#888">{{ p.sampler|e }}</span>{% endif %}
            {% for tag in tags_list %}
            {% set t = tag.strip() %}
            {% if t %}<span class="tag">{{ t|e }}</span>{% endif %}
            {% endfor %}
          </div>
          <div class="prompt-indicators">
            <span class="indicator-fav{% if p.is_favorite %} active{% endif %}"
                  onclick="event.stopPropagation();window.togglePromptFavorite({{ p.id }}, this)"
                  title="收藏">{{ '★' if p.is_favorite else '☆' }}</span>
            {% if p.is_pinned %}<span class="indicator-pin active" title="置顶">📌</span>{% endif %}
            {% if p.rating %}<span class="indicator-rating" title="评级">{% for _ in range(p.rating) %}⭐{% endfor %}</span>{% endif %}
            {% if p.usage_count > 0 %}<span class="usage-count" title="使用次数">🔄{{ p.usage_count }}</span>{% endif %}
          </div>
        </div>
      </div>
    </div>
    {% endif %}
    {% endfor %}
    {% else %}
    <div class="empty-tip">暂无匹配的提示词</div>
    {% endif %}
  </div>

  <div class="pagination" id="promptPagination">
    {% set total_pages = ((total + page_size - 1) // page_size) if total > 0 else 1 %}
    <span class="page-info">第 {{ page }}/{{ total_pages }} 页，共 {{ total }} 条</span>
    <span class="page-info">每页
      <select class="page-size-select" onchange="window.changePromptPageSize(parseInt(this.value))">
        <option value="20" {{ 'selected' if page_size == 20 }}>20</option>
        <option value="50" {{ 'selected' if page_size == 50 }}>50</option>
        <option value="100" {{ 'selected' if page_size == 100 }}>100</option>
        <option value="200" {{ 'selected' if page_size == 200 }}>200</option>
        <option value="500" {{ 'selected' if page_size == 500 }}>500</option>
        <option value="1000" {{ 'selected' if page_size == 1000 }}>1000</option>
      </select>
      条
    </span>
    {% if total_pages > 1 %}
    <button class="page-btn" {{ 'disabled' if page <= 1 }}
            hx-get="/api/prompts/html?page=1&page_size={{ page_size }}&search={{ search }}&sort={{ sort }}&category_id={{ category_id or '' }}&tag_ids={{ tag_ids or '' }}"
            hx-target="#promptListContainer" hx-swap="outerHTML">«</button>
    <button class="page-btn" {{ 'disabled' if page <= 1 }}
            hx-get="/api/prompts/html?page={{ page - 1 }}&page_size={{ page_size }}&search={{ search }}&sort={{ sort }}&category_id={{ category_id or '' }}&tag_ids={{ tag_ids or '' }}"
            hx-target="#promptListContainer" hx-swap="outerHTML">‹</button>
    {% set start = [1, page - 2]|max %}
    {% set end = [total_pages, start + 4]|min %}
    {% set start = [1, end - 4]|max %}
    {% for i in range(start, end + 1) %}
    <button class="page-btn{{ ' active' if i == page }}"
            hx-get="/api/prompts/html?page={{ i }}&page_size={{ page_size }}&search={{ search }}&sort={{ sort }}&category_id={{ category_id or '' }}&tag_ids={{ tag_ids or '' }}"
            hx-target="#promptListContainer" hx-swap="outerHTML">{{ i }}</button>
    {% endfor %}
    <button class="page-btn" {{ 'disabled' if page >= total_pages }}
            hx-get="/api/prompts/html?page={{ page + 1 }}&page_size={{ page_size }}&search={{ search }}&sort={{ sort }}&category_id={{ category_id or '' }}&tag_ids={{ tag_ids or '' }}"
            hx-target="#promptListContainer" hx-swap="outerHTML">›</button>
    <button class="page-btn" {{ 'disabled' if page >= total_pages }}
            hx-get="/api/prompts/html?page={{ total_pages }}&page_size={{ page_size }}&search={{ search }}&sort={{ sort }}&category_id={{ category_id or '' }}&tag_ids={{ tag_ids or '' }}"
            hx-target="#promptListContainer" hx-swap="outerHTML">»</button>
    {% endif %}
  </div>
</div>
