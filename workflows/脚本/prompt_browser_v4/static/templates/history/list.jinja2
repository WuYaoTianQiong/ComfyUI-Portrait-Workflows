<div id="galleryGridInner">
  <div class="gallery-grid" id="galleryGrid">
    {% if items and items|length > 0 %}
    {% for item in items %}
    {% set thumb_url = '/api/thumbnail?filename=' + item.filename|urlencode + '&subfolder=' + (item.subfolder or '')|urlencode + '&type=' + (item.img_type or 'output')|urlencode + '&size=600&v=' + (item.created_at or item.id|string)|urlencode %}
    {% set has_prompt = item.prompt_id is not none %}
    {% set prompt_params = item.prompt_params %}
    {% set composer_prompt = '' %}
    {% set is_random = false %}
    {% if prompt_params %}
      {% if prompt_params.source == 'composer' and prompt_params.prompt %}
        {% set composer_prompt = prompt_params.prompt[:80] %}
      {% endif %}
      {% if prompt_params.source == 'composer_random' %}
        {% set is_random = true %}
      {% endif %}
    {% endif %}
    {% set badge_top = namespace(value=8) %}
    <div class="gallery-item" data-id="{{ item.id }}" data-index="{{ loop.index0 }}">
      <img src="{{ thumb_url }}" alt=""
           onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
      <div class="gallery-item-placeholder" style="display:none">🖼️</div>
      <button class="gallery-item-fav {{ 'active' if item.favorite }}"
              onclick="event.stopPropagation();window.toggleFavorite({{ item.id }}, this)"
              title="收藏">{{ '★' if item.favorite else '☆' }}</button>
      {% if item.prompt_name %}
      <div class="gallery-item-prompt" style="top:{{ badge_top.value }}px"
           onclick="event.stopPropagation();window.jumpToPrompt({{ item.prompt_id }})">
        📝 {{ item.prompt_name|e }}</div>
      {% set badge_top.value = badge_top.value + 30 %}
      {% endif %}
      {% if composer_prompt %}
      <div class="gallery-item-prompt gallery-item-prompt-composer" style="top:{{ badge_top.value }}px"
           title="{{ composer_prompt|e }}">🧩 {{ composer_prompt|e }}</div>
      {% set badge_top.value = badge_top.value + 30 %}
      {% endif %}
      {% if is_random %}
      <div class="gallery-item-prompt gallery-item-prompt-random" style="top:{{ badge_top.value }}px"
           onclick="event.stopPropagation();window.showRandomPromptDetail({{ item.id }})"
           title="点击查看随机组合详情">🎲 随机组合</div>
      {% endif %}
      <div class="gallery-item-check" data-id="{{ item.id }}"></div>
      <div class="gallery-item-actions">
        {% if has_prompt %}
        <button class="gallery-item-regen" onclick="event.stopPropagation();window.regenerateFromHistory({{ item.prompt_id }})" title="重新生成">🔄</button>
        {% endif %}
        <button class="gallery-item-dl" onclick="event.stopPropagation();window.downloadHistoryItem({{ item.id }})" title="下载">⬇️</button>
      </div>
    </div>
    {% endfor %}
    {% else %}
    <div class="empty-tip">暂无历史图片</div>
    {% endif %}
  </div>
  <div class="pagination gallery-pagination" id="galleryPagination"
       style="margin-top:12px;text-align:center;padding:8px 0">
    {% set total_pages = ((total + page_size - 1) // page_size) if total > 0 else 1 %}
    <span class="page-info">第 {{ page }}/{{ total_pages }} 页，共 {{ total }} 张</span>
    <span class="page-info">每页
      <select class="page-size-select" onchange="window.changeGalleryPageSize(parseInt(this.value))">
        {% for sz in [20, 50, 100, 200, 500, 1000] %}
        <option value="{{ sz }}" {{ 'selected' if sz == page_size }}>{{ sz }}</option>
        {% endfor %}
      </select>
      条
    </span>
    {% if total_pages > 1 %}
    <button class="page-btn" {{ 'disabled' if page <= 1 }}
            hx-get="/api/history/html?page=1&page_size={{ page_size }}&sort={{ sort }}&favorite={{ '1' if favorite else '' }}&search={{ search }}"
            hx-target="#galleryGridInner" hx-swap="outerHTML">«</button>
    <button class="page-btn" {{ 'disabled' if page <= 1 }}
            hx-get="/api/history/html?page={{ page - 1 }}&page_size={{ page_size }}&sort={{ sort }}&favorite={{ '1' if favorite else '' }}&search={{ search }}"
            hx-target="#galleryGridInner" hx-swap="outerHTML">‹</button>
    {% set start = [1, page - 2]|max %}
    {% set end = [total_pages, start + 4]|min %}
    {% set start = [1, end - 4]|max %}
    {% for i in range(start, end + 1) %}
    <button class="page-btn{{ ' active' if i == page }}"
            hx-get="/api/history/html?page={{ i }}&page_size={{ page_size }}&sort={{ sort }}&favorite={{ '1' if favorite else '' }}&search={{ search }}"
            hx-target="#galleryGridInner" hx-swap="outerHTML">{{ i }}</button>
    {% endfor %}
    <button class="page-btn" {{ 'disabled' if page >= total_pages }}
            hx-get="/api/history/html?page={{ page + 1 }}&page_size={{ page_size }}&sort={{ sort }}&favorite={{ '1' if favorite else '' }}&search={{ search }}"
            hx-target="#galleryGridInner" hx-swap="outerHTML">›</button>
    <button class="page-btn" {{ 'disabled' if page >= total_pages }}
            hx-get="/api/history/html?page={{ total_pages }}&page_size={{ page_size }}&sort={{ sort }}&favorite={{ '1' if favorite else '' }}&search={{ search }}"
            hx-target="#galleryGridInner" hx-swap="outerHTML">»</button>
    {% endif %}
  </div>
</div>
